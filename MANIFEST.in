recursive-include kikit/resources *

exclude kikit/resources/present/templates/*/package*.json
prune   kikit/resources/present/templates/*/src
exclude kikit/resources/present/templates/*/postcss.config.js
exclude kikit/resources/present/templates/*/tailwind.config.js
prune   kikit/resources/present/templates/*/node_modules

include kikit/_version.py
include versioneer.py
